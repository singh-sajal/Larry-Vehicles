APP_NAME=WheelDeal
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wheeldeal.example

APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wheeldeal
DB_USERNAME=wheeldeal
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=public
# Keep this relative so media works on any host/port. Use an absolute CDN URL if needed.
FILESYSTEM_PUBLIC_URL=/storage
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@wheeldeal.example"
MAIL_FROM_NAME="${APP_NAME}"

CONTACT_PHONE="+91 98765 43210"
CONTACT_WHATSAPP="919876543210"
CONTACT_EMAIL="hello@wheeldeal.example"
CONTACT_ADDRESS="2nd Floor, 12 MG Road, Bengaluru, Karnataka 560001"

CATALOG_CACHE_TTL=600
HOME_CACHE_TTL=300

# SMS: msg91 | twilio | log. WhatsApp: whatsapp | log.
OTP_SMS_DRIVER=msg91
OTP_WHATSAPP_DRIVER=whatsapp
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN=30
OTP_PHONE_LIMIT=5
OTP_IP_LIMIT=15

MSG91_AUTH_KEY=
MSG91_SENDER_ID=WHEELD
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=otp_verification

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

SEO_DEFAULT_TITLE="WheelDeal — Buy & Sell Used Cars in India"
SEO_DEFAULT_DESCRIPTION="Browse verified used SUVs, sedans, hatchbacks and EVs by brand, budget, fuel and city. Compare specs, view 360° interiors and connect with trusted sellers."
SEO_TWITTER_HANDLE="@wheeldeal"

SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=
SOCIAL_X=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_TURNSTILE_SITE_KEY="${TURNSTILE_SITE_KEY}"
